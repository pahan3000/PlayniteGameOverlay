                  <Path Data="m7.005 31.081 c2.0801 4.0786 6.0077 5.6941 9.4737 6.0679 4.734 .5106 7.698 -1.5138 8.1383 -1.8298 1.8085 -1.2979 2.6869 -2.5717 2.6869 -4.443 s-.8731 -3.3883 -3.3883 -3.3883 c-1.8713 0 -2.3997 .8419 -4.1231 2.1983 -.5333 .4197 -1.75 1.0585 -4.7267 .7663 -2.1736 -.2134 -2.7574 -1.7397 -4.853 -1.2218" Style="{StaticResource SonicStroke}"/>
