<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:PlayniteGameOverlay" xmlns:System="clr-namespace:System;assembly=mscorlib" x:Class="PlayniteGameOverlay.OverlaySettingsView">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ExtensionTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="AccentBrush" Color="#FF66C0F4"/>
      <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF1A1D23"/>
      <!-- Windows 11 volume-style slider: thin rail, accent fill, white thumb + soft accent halo -->
      <Style x:Key="FluentSliderRailButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Background" Value="#FF8A8A8A"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RepeatButton">
              <Grid Background="Transparent">
                <Border Height="3" CornerRadius="1.5" Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="FluentSliderThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Thumb">
              <Grid Background="Transparent">
                <!-- Covers the rail under the knob so no grey rim shows through -->
                <Ellipse Width="16" Height="16" Fill="{DynamicResource PanelBackgroundBrush}"/>
                <Ellipse x:Name="Knob" Width="14" Height="14" Fill="#FFFFFFFF"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsDragging" Value="True">
                  <Setter TargetName="Knob" Property="Fill" Value="#FFFFFFFF"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <ControlTemplate x:Key="FluentSliderTemplate" TargetType="Slider">
        <Grid x:Name="SliderRoot" Background="Transparent" SnapsToDevicePixels="False" Height="28" MinHeight="28" Cursor="Hand">
          <!-- Full unfilled rail -->
          <Border Height="3" CornerRadius="1.5" Background="#FF8A8A8A" VerticalAlignment="Center" Margin="14,0" IsHitTestVisible="False"/>
          <!-- Track is visual only — pointer drag is handled in code (smooth under Viewbox) -->
          <Track x:Name="PART_Track" VerticalAlignment="Center" IsHitTestVisible="False">
            <Track.DecreaseRepeatButton>
              <RepeatButton Style="{StaticResource FluentSliderRailButton}" Background="{DynamicResource AccentBrush}" IsHitTestVisible="False"/>
            </Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton>
              <RepeatButton Style="{StaticResource FluentSliderRailButton}" Background="Transparent" IsHitTestVisible="False"/>
            </Track.IncreaseRepeatButton>
            <Track.Thumb>
              <Thumb x:Name="SliderThumb" Style="{StaticResource FluentSliderThumb}" IsHitTestVisible="False"/>
            </Track.Thumb>
          </Track>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True">
            <Setter TargetName="SliderThumb" Property="Tag" Value="focused"/>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Opacity" Value="0.4"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="OverlayFocusSlider" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="IsMoveToPointEnabled" Value="False"/>
        <Setter Property="IsSnapToTickEnabled" Value="False"/>
        <Setter Property="IsManipulationEnabled" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template" Value="{StaticResource FluentSliderTemplate}"/>
        <!-- Sliders inside collapsed Expanders are not in the visual tree when the view loads,
                 so each one hooks itself the first time it is actually created. -->
        <EventSetter Event="Loaded" Handler="Slider_Loaded"/>
      </Style>
      <ObjectDataProvider x:Key="ControllerShortcutEnum" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
        <ObjectDataProvider.MethodParameters>
          <x:Type TypeName="local:ControllerShortcut"/>
        </ObjectDataProvider.MethodParameters>
      </ObjectDataProvider>
      <ObjectDataProvider x:Key="CloseBehaviorEnum" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
        <ObjectDataProvider.MethodParameters>
          <x:Type TypeName="local:CloseBehavior"/>
        </ObjectDataProvider.MethodParameters>
      </ObjectDataProvider>
      <ObjectDataProvider x:Key="AspectRatioEnum" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
        <ObjectDataProvider.MethodParameters>
          <x:Type TypeName="local:AspectRatio"/>
        </ObjectDataProvider.MethodParameters>
      </ObjectDataProvider>
      <local:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
      <local:ShortcutLabelConverter x:Key="ShortcutLabelConverter"/>
      <ObjectDataProvider x:Key="ButtonPromptStyleEnum" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
        <ObjectDataProvider.MethodParameters>
          <x:Type TypeName="local:ButtonPromptStyle"/>
        </ObjectDataProvider.MethodParameters>
      </ObjectDataProvider>
      <Style x:Key="HotkeyRow" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,6"/>
      </Style>
      <SolidColorBrush x:Key="UiCard" Color="#FF23262E"/>
      <SolidColorBrush x:Key="UiCardHover" Color="#FF3D4450"/>
      <SolidColorBrush x:Key="UiBorder" Color="#FF23262E"/>
      <SolidColorBrush x:Key="UiBorderHover" Color="#FF434953"/>
      <SolidColorBrush x:Key="UiDivider" Color="#FF3D4450"/>
      <SolidColorBrush x:Key="UiAccent" Color="#FF4A9EFF"/>
      <SolidColorBrush x:Key="PreviewSurfaceBrush" Color="#FF1E2028"/>
      <Style x:Key="GlobalSettingsButton" TargetType="Button">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Background" Value="{DynamicResource UiButton}"/>
        <Setter Property="Foreground" Value="#FFF1F3F6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource UiButtonCornerRadius}">
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Surface" Property="Opacity" Value="0.86"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Surface" Property="Opacity" Value="0.70"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="Button" BasedOn="{StaticResource GlobalSettingsButton}"/>
      <Style x:Key="ReShadePanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource UiCard}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource UiDivider}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="14,12"/>
      </Style>
      <!-- Global settings use the same enclosed section treatment as the per-game menu. -->
      <ControlTemplate x:Key="UnifiedSectionTemplate" TargetType="Expander">
        <Border x:Name="Outer" Background="{DynamicResource UiCard}" BorderBrush="{DynamicResource UiBorder}" BorderThickness="1" CornerRadius="{DynamicResource UiSectionCornerRadius}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" MinHeight="42"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border x:Name="HeaderBg" Grid.Row="0" Background="Transparent" CornerRadius="{DynamicResource UiSectionHeaderCornerRadius}">
              <Grid>
                <Border x:Name="ExpandedAccent" Width="3" HorizontalAlignment="Left" Margin="0,8,0,8" CornerRadius="1.5" Background="{DynamicResource ReShadeAccent}" Visibility="Collapsed" IsHitTestVisible="False"/>
                <ToggleButton x:Name="HeaderToggle" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="13,0">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Content" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                      </Border>
                    </ControlTemplate>
                  </ToggleButton.Template>
                  <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                </ToggleButton>
              </Grid>
            </Border>
            <Border x:Name="ContentBorder" Grid.Row="1" Visibility="Collapsed" BorderBrush="{DynamicResource UiDivider}" BorderThickness="0,1,0,0" Padding="14,12,14,14" Background="{DynamicResource ReShadeBg}" CornerRadius="{DynamicResource UiSectionContentCornerRadius}">
              <ContentPresenter ContentSource="Content"/>
            </Border>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource UiBorderHover}"/>
            <Setter TargetName="HeaderBg" Property="Background" Value="{DynamicResource UiCardHover}"/>
          </Trigger>
          <Trigger Property="IsExpanded" Value="True">
            <Setter TargetName="ContentBorder" Property="Visibility" Value="Visible"/>
            <Setter TargetName="HeaderBg" Property="Background" Value="{DynamicResource UiExpandedHeader}"/>
            <Setter TargetName="ExpandedAccent" Property="Visibility" Value="Visible"/>
            <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource UiBorderHover}"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <!-- Separate neutral cards follow Windows Settings; open state stays clear without arrows. -->
      <ControlTemplate x:Key="Windows11SectionTemplate" TargetType="Expander">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="52"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border x:Name="HeaderBg" Background="{DynamicResource UiCard}" CornerRadius="4">
            <Grid>
              <Border x:Name="ExpandedAccent" Width="3" HorizontalAlignment="Left" Margin="0,9,0,9" CornerRadius="1.5" Background="{DynamicResource ReShadeAccent}" Visibility="Collapsed" Opacity="0.8" IsHitTestVisible="False"/>
              <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Cursor="Hand" Padding="16,12" HorizontalContentAlignment="Stretch">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                      <ContentPresenter ContentSource="Content" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
              </ToggleButton>
            </Grid>
          </Border>
          <ContentPresenter x:Name="ContentSite" Grid.Row="1" Visibility="Collapsed" ContentSource="Content" Margin="0,5,0,0"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="HeaderBg" Property="Background" Value="{DynamicResource UiHeaderHover}"/>
          </Trigger>
          <Trigger Property="IsExpanded" Value="True">
            <Setter TargetName="ContentSite" Property="Visibility" Value="Visible"/>
            <Setter TargetName="HeaderBg" Property="Background" Value="{DynamicResource UiExpandedHeader}"/>
            <Setter TargetName="ExpandedAccent" Property="Visibility" Value="Visible"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="TreeBranchExpander" TargetType="Expander">
        <Setter Property="IsExpanded" Value="False"/>
        <Setter Property="Foreground" Value="{DynamicResource ReShadeText}"/>
        <Setter Property="Template" Value="{StaticResource Windows11SectionTemplate}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
      </Style>
      <Style TargetType="Expander" BasedOn="{StaticResource TreeBranchExpander}"/>
      <!-- Setting rows: one clear block per setting, with a divider -->
      <Style x:Key="SteamSettingsRow" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource UiCard}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="MinHeight" Value="56"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
      </Style>
      <Style TargetType="CheckBox" BasedOn="{StaticResource OverlaySettingsSwitch}"/>
      <Style x:Key="SettingRow" TargetType="Border" BasedOn="{StaticResource SteamSettingsRow}"/>
      <Style x:Key="SettingRowLast" TargetType="Border" BasedOn="{StaticResource SettingRow}"/>
      <Style x:Key="SettingNote" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ReShadeTextMuted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="17"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid x:Name="SettingsLayoutRoot">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SettingsContentColumn" Width="*"/>
      <ColumnDefinition x:Name="PreviewPaneColumn" Width="0"/>
    </Grid.ColumnDefinitions>
  <ScrollViewer x:Name="SettingsScrollViewer" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource ReShadeBg}">
    <StackPanel Margin="24,20,24,24">
      <!-- General -->
      <Expander IsExpanded="False" Margin="0,0,0,8">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource Win11OutlineIcon}" Data="{StaticResource GearIconGeometry}"/>
            <TextBlock Text="General" FontWeight="Normal" FontSize="{DynamicResource FontSizeLarge}" VerticalAlignment="Center"/>
          </StackPanel>
        </Expander.Header>
        <StackPanel Margin="0">
          <Border Style="{StaticResource SettingRow}">
            <DockPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Close behavior" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" Width="220" HorizontalAlignment="Left" ItemsSource="{Binding Source={StaticResource CloseBehaviorEnum}}" SelectedItem="{Binding CloseBehavior}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource SettingRow}">
            <DockPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Cover shape" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" Width="220" HorizontalAlignment="Left" ItemsSource="{Binding Source={StaticResource AspectRatioEnum}}" SelectedItem="{Binding AspectRatio}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource SettingRow}">
            <DockPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Settings theme" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <ComboBox Width="220" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{Binding SettingsThemePreset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Content="Steam" Tag="Steam"/>
                    <ComboBoxItem Content="Steam Dark" Tag="Steam Dark"/>
                    <ComboBoxItem Content="Windows 11" Tag="Windows 11"/>
                  </ComboBox>
                  <CheckBox Content="Glass effect" IsChecked="{Binding SettingsMenuGlass}" Margin="14,0,0,0" VerticalAlignment="Center" ToolTip="Glass effect for these settings menus (global and per-game)"/>
                </StackPanel>
              </Grid>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource SettingRow}">
            <DockPanel>
              <StackPanel>
                <CheckBox Content="Suspend game while overlay open" IsChecked="{Binding PauseGameWhileOverlayOpen}" Margin="0"/>
                <TextBlock Style="{StaticResource SettingNote}" Text="Suspends the game process while the overlay is open. Unreal Engine and Easy Anti-Cheat games are never suspended."/>
              </StackPanel>
            </DockPanel>
          </Border>
          <!-- hotkeys-layout: the PrintScreen remap now lives under Hotkeys > Keyboard -->
          <Border Style="{StaticResource SettingRow}">
            <DockPanel>
              <StackPanel>
                <CheckBox Content="Alt+F4 force-close" IsChecked="{Binding EnableAltF4InstantClose}" Margin="0"/>
                <TextBlock Style="{StaticResource SettingNote}" Text="Alt+F4 closes the game straight away."/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource SettingRow}">
            <DockPanel>
              <StackPanel>
                <CheckBox Content="Force Windows Game Mode in all games" IsChecked="{Binding EnableWindowsGameModeRegistration}" Margin="0"/>
                <TextBlock Style="{StaticResource SettingNote}" Text="Only 2 out of 10 games actually use Windows Game Mode by default. This option aims to fix that. Shout-out to Kaldaien for sharing the code."/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource SettingRow}">
            <DockPanel>
              <StackPanel>
                <CheckBox Content="Automatically assign the PC platform to manually added games" IsChecked="{Binding AutoPcPlatformForNewGames}" Margin="0"/>
                <TextBlock Style="{StaticResource SettingNote}" Text="Games you add yourself will be assigned the PC platform."/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource SettingRow}">
            <DockPanel>
              <StackPanel>
                <CheckBox Content="Borderless window mode" IsChecked="{Binding BorderlessWindowedGames}" Margin="0"/>
                <TextBlock Style="{StaticResource SettingNote}" Text="Removes the window border and fills the screen. Applies the next time a game starts."/>
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </Expander>
      <!-- Controller -->
      <Expander IsExpanded="False" Margin="0,0,0,8">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource Win11OutlineIcon}" Data="{StaticResource ControllerIconGeometry}"/>
            <TextBlock Text="Controller" FontWeight="Normal" FontSize="{DynamicResource FontSizeLarge}" VerticalAlignment="Center"/>
          </StackPanel>
        </Expander.Header>
        <StackPanel Margin="0">
          <Border Style="{StaticResource SettingRow}">
            <DockPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Controller shortcut" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" Width="220" HorizontalAlignment="Left" ItemsSource="{Binding Source={StaticResource ControllerShortcutEnum}}" SelectedItem="{Binding ControllerShortcut}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock>
                        <TextBlock.Text>
                          <MultiBinding Converter="{StaticResource ShortcutLabelConverter}">
                            <Binding/>
                            <Binding Path="DataContext.ButtonPromptStyle" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                          </MultiBinding>
                        </TextBlock.Text>
                      </TextBlock>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource SettingRow}">
            <DockPanel>
              <StackPanel>
                <CheckBox Content="Desktop controller navigation" IsChecked="{Binding EnableDesktopControllerNav}" Margin="0"/>
                <TextBlock Style="{StaticResource SettingNote}" Text="Use a controller in Playnite Desktop. A selects, B goes back."/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource SettingRow}">
            <DockPanel>
              <StackPanel>
                <CheckBox Content="Show gamepad button prompts" IsChecked="{Binding ShowGamepadHints}" Margin="0"/>
                <TextBlock Style="{StaticResource SettingNote}" Text="Shows a hint bar in the overlay with the controller buttons for moving, selecting and going back."/>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Button prompt style" VerticalAlignment="Center"/>
                  <ComboBox Grid.Column="1" Width="220" HorizontalAlignment="Left"
                            ItemsSource="{Binding Source={StaticResource ButtonPromptStyleEnum}}"
                            SelectedItem="{Binding ButtonPromptStyle}"
                            IsEnabled="{Binding ShowGamepadHints}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
                <TextBlock Style="{StaticResource SettingNote}" Text="Auto shows PlayStation symbols (L1, R1, L2, R2, ✕, ○ icons) when a DualShock 4 / DualSense is the pad in use, and Xbox labels otherwise. The Controller shortcut names above follow this too."/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource SettingRowLast}">
            <DockPanel>
              <StackPanel>
                <CheckBox Content="Hide cursor on gamepad" IsChecked="{Binding HideCursorOnGamepad}" Margin="0"/>
                <TextBlock Style="{StaticResource SettingNote}" Text="Hides the mouse pointer while you use a controller."/>
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </Expander>
      <!-- Instant Play -->
      <Expander IsExpanded="False" Margin="0,0,0,8">
        <Expander.Header>
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="20" Height="20" Margin="-1,0,13,0" VerticalAlignment="Center">
                <Canvas Width="48" Height="48">
