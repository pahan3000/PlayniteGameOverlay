                  <Path Data="m44.4149 12.9149 C38.1915 1.7447 21.7993 4.1772 14.1489 8.8298 c-3.1322 1.9048 -7.2768 4.5406 -8.6305 9.4428 -.6762 2.4488 -.656 5.4632 .5347 9.2345" Style="{StaticResource SonicStroke}"/>
