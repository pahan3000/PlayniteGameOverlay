<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:local="clr-namespace:PlayniteGameOverlay"
        xmlns:sys="clr-namespace:System.Windows;assembly=PresentationFramework"
        mc:Ignorable="d av"
        d:DataContext="{d:DesignInstance Type=local:OverlayWindowViewModel, IsDesignTimeCreatable=True}"
        x:Class="PlayniteGameOverlay.OverlayWindow"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ResizeMode="NoResize"
        WindowState="Maximized"
        ShowInTaskbar="False"
        Cursor="Arrow"
        av:DesignHeight="900" 
        av:DesignWidth="1600" 
        Width="1600">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Theme (defaults = the original look). Replaced at runtime from the Appearance settings. -->
        <SolidColorBrush x:Key="AccentBrush" Color="#FF66C0F4"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#FF1565C0"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF1A1D23"/>
        <SolidColorBrush x:Key="AchievementPanelBrush" Color="#FF1A1D23"/>
        <SolidColorBrush x:Key="AchievementItemBrush" Color="#FF1E2028"/>
        <SolidColorBrush x:Key="AchievementItemHoverBrush" Color="#FF2A2D35"/>
        <SolidColorBrush x:Key="AchievementItemBorderBrush" Color="#00000000"/>
        <!-- Hover/focus rim is assigned from the active panel appearance at runtime -->
        <SolidColorBrush x:Key="FocusRimBrush" Color="#FFD6D9DE"/>
        <Thickness x:Key="FocusRimThickness">2</Thickness>
        <SolidColorBrush x:Key="AchievementSelectedBrush" Color="#FF2A2D35"/>
        <SolidColorBrush x:Key="AchievementSelectedBorderBrush" Color="#FFD6D9DE"/>
        <SolidColorBrush x:Key="AchievementWindowBrush" Color="#FF16181D"/>
        <SolidColorBrush x:Key="AchievementWindowBorderBrush" Color="#FF2A2D35"/>
        <SolidColorBrush x:Key="AchievementHeaderBrush" Color="#FF1A1D23"/>
        <SolidColorBrush x:Key="AchievementDividerBrush" Color="#FF2A2D35"/>
        <DrawingBrush x:Key="AchievementStripeBrush" TileMode="Tile" Viewbox="0,0,14,14" ViewboxUnits="Absolute" Viewport="0,0,14,14" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="0,14" EndPoint="14,0"/>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#668EA0B4" Thickness="1"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <LinearGradientBrush x:Key="AchTintGoldBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00E4AE39" Offset="0"/>
            <GradientStop Color="#1EE4AE39" Offset="0.5"/>
            <GradientStop Color="#80E4AE39" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AchTintPurpleBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00B072FF" Offset="0"/>
            <GradientStop Color="#1EB072FF" Offset="0.5"/>
            <GradientStop Color="#80B072FF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AchTintBlueBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#002F8FD8" Offset="0"/>
            <GradientStop Color="#222F8FD8" Offset="0.5"/>
            <GradientStop Color="#8C2F8FD8" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AchTintGreenBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#005BAE5B" Offset="0"/>
            <GradientStop Color="#1C5BAE5B" Offset="0.5"/>
            <GradientStop Color="#745BAE5B" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AchTintSilverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00A0B0C0" Offset="0"/>
            <GradientStop Color="#18A0B0C0" Offset="0.5"/>
            <GradientStop Color="#66A0B0C0" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AchTintBronzeBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00C2603F" Offset="0"/>
            <GradientStop Color="#1EC2603F" Offset="0.5"/>
            <GradientStop Color="#7AC2603F" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="AchievementTintPane" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AchTintBronzeBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RarityColor}" Value="#FFE4AE39"><Setter Property="Background" Value="{StaticResource AchTintGoldBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding RarityColor}" Value="#FFB072FF"><Setter Property="Background" Value="{StaticResource AchTintPurpleBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding RarityColor}" Value="#FF66C0F4"><Setter Property="Background" Value="{StaticResource AchTintBlueBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding RarityColor}" Value="#FF5BAE5B"><Setter Property="Background" Value="{StaticResource AchTintGreenBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding RarityColor}" Value="#FFA0B0C0"><Setter Property="Background" Value="{StaticResource AchTintSilverBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <SolidColorBrush x:Key="CoverFrameBrush" Color="#80808080"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FF1E2028"/>
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FF2A2D35"/>
        <SolidColorBrush x:Key="SelectedSurfaceBrush" Color="#FF2A2D35"/>
        <!-- Active/selected item (FPS preset etc.): replaced at runtime by ApplyTheme -->
        <LinearGradientBrush x:Key="SelectedAccentBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5866C0F4" Offset="0"/>
            <GradientStop Color="#2466C0F4" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SelectedAccentRimBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#80FFFFFF" Offset="0"/>
            <GradientStop Color="#5099D4F7" Offset="0.5"/>
            <GradientStop Color="#1CFFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <Color x:Key="AccentGlowColor">#FF66C0F4</Color>
        <!-- Diagonal specular sheen shared by selected/focused glass controls -->
        <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#40FFFFFF" Offset="0"/>
            <GradientStop Color="#12FFFFFF" Offset="0.45"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="SelectedForegroundBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FF2A2222"/>
        <SolidColorBrush x:Key="DangerForegroundBrush" Color="#FFFF8A80"/>
        <CornerRadius x:Key="PanelCornerRadius">10</CornerRadius>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#00000000"/>
        <Thickness x:Key="PanelBorderThickness">0</Thickness>
        <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
        <!-- Shared focus style: neutral, panel-contrast ring from the active appearance preset -->
        <Style x:Key="OverlayFocusButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                RenderTransformOrigin="0.5,0.5">
                            <Grid>
                                <!-- Diagonal specular sheen, only while hovered/focused -->
                                <Border x:Name="Sheen" CornerRadius="5" Opacity="0" IsHitTestVisible="False"
                                        Background="{DynamicResource GlassSheenBrush}"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter TargetName="Sheen" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusRimBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="{DynamicResource FocusRimThickness}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}"/>
                                <Setter TargetName="Sheen" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OverlayFocusButtonDanger" TargetType="Button" BasedOn="{StaticResource OverlayFocusButton}">
            <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}"/>
        </Style>
        <Style x:Key="FpsPresetButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <!-- Active: faint accent-tinted frosted pane, top-lit rim -->
                                    <Border x:Name="SelFill" CornerRadius="5" Opacity="0" IsHitTestVisible="False"
                                            Background="{DynamicResource SelectedAccentBrush}"/>
                                    <Border x:Name="SelRim" CornerRadius="5" Opacity="0" IsHitTestVisible="False"
                                            BorderThickness="1" BorderBrush="{DynamicResource SelectedAccentRimBrush}"/>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="SelRim" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="SelRim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusRimBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="{DynamicResource FocusRimThickness}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusRimBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="{DynamicResource FocusRimThickness}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Circular icon-only close button (e.g. achievement browser header) -->
        <Style x:Key="OverlayCloseButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="#FFC7D5E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF35383F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Windows 11 volume-style slider: thin rail, accent fill, white thumb + soft accent halo -->
        <Style x:Key="FluentSliderRailButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="#FF8A8A8A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="3" CornerRadius="1.5" Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FluentSliderThumb" TargetType="Thumb">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <!-- The white thumb covers the rail; avoid a panel-colored gap before it. -->
                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="#FFFFFFFF"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Knob" Property="Fill" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <ControlTemplate x:Key="FluentSliderTemplate" TargetType="Slider">
            <Grid x:Name="SliderRoot" Background="Transparent" SnapsToDevicePixels="False" Height="28" MinHeight="28"
                  Cursor="Hand">
                <!-- Separate filled/unfilled rails; no gray rail under the blue fill. -->
                <Track x:Name="PART_Track" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource FluentSliderRailButton}" Background="{DynamicResource AccentBrush}" IsHitTestVisible="False"/>
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource FluentSliderRailButton}" Background="#FF8A8A8A" IsHitTestVisible="False"/>
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb x:Name="SliderThumb" Style="{StaticResource FluentSliderThumb}" IsHitTestVisible="False"/>
                    </Track.Thumb>
                </Track>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="SliderThumb" Property="Tag" Value="focused"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="OverlayFocusSlider" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="IsTabStop" Value="True"/>
            <Setter Property="IsMoveToPointEnabled" Value="False"/>
            <Setter Property="IsSnapToTickEnabled" Value="False"/>
            <Setter Property="IsManipulationEnabled" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource FluentSliderTemplate}"/>
        </Style>

    </Window.Resources>

    <!-- Outer grid fills the entire monitor so letterboxed / transparent
         regions still capture mouse (WPF click-through fix). -->
    <Grid x:Name="RootGrid" Background="#CC000000" IsHitTestVisible="True">
    <!-- Blurred game artwork shown behind the overlay when a fullscreen game steps aside. -->
    <Image x:Name="BackdropImage" Stretch="UniformToFill" Visibility="Collapsed" IsHitTestVisible="False"
           RenderOptions.BitmapScalingMode="LowQuality"/>
    <Rectangle x:Name="BackdropScrim" Fill="#73000000" Visibility="Collapsed" IsHitTestVisible="False"/>
    <Image x:Name="BackdropBanner" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False"
           RenderOptions.BitmapScalingMode="HighQuality"/>
    <Viewbox Stretch="Uniform">
        <!-- Set a container with fixed aspect ratio -->
        <Grid x:Name="DesignCanvas" Width="1600" Height="900" Background="#00000000" IsHitTestVisible="True">
            <!-- Design-time dim; real dim comes from outer Grid -->
            <Rectangle Fill="#00000000" IsHitTestVisible="False" />

            <!-- Invisible focus parking spot: while the mouse is in use, keyboard/logical focus rests here so no
                 button shows the controller-focus highlight. Not focusable except while parked. -->
            <ContentControl x:Name="FocusSink" Width="1" Height="1" Opacity="0" IsHitTestVisible="False"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Focusable="False" IsTabStop="False"
                    FocusVisualStyle="{x:Null}"/>

            <!-- Left column: buttons + achievements + volume (same in Desktop & Fullscreen) -->
            <StackPanel x:Name="LeftColumn" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="38,120,0,0" Width="380">
            <Border x:Name="MainActionsPanel" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="{DynamicResource PanelCornerRadius}" Padding="20" 
                Width="300" Height="Auto" HorizontalAlignment="Left" Margin="0,0,0,16" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="{DynamicResource PanelBorderThickness}">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Width="260">
                    <!-- Windows 11 style buttons with icons -->
                    <Button x:Name="ShowPlayniteButton" Height="70" Width="260" 
                        FontSize="20" FontWeight="SemiBold"
                        Padding="20,10" Margin="0,0,0,20"
                        Command="{Binding ShowPlayniteCommand}" ClickMode="Press"
                        Visibility="{Binding ShowPlayniteButton, Converter={StaticResource BoolToVis}}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Path Data="M 53.760 28.496 C 33.560 33.609, 22.270 49.113, 11.485 86.552 C -1.871 132.917, -3.512 171.688, 7.418 182.618 C 16.377 191.577, 28.929 186.235, 46.444 166.008 C 62.325 147.668, 61.688 147.872, 105 147.265 C 154.990 146.565, 161.600 147.871, 172.538 160.607 C 189.871 180.789, 199.516 187.766, 208.662 186.735 C 216.030 185.904, 219.883 181.093, 222.732 169.164 C 224.636 161.195, 225.526 144.474, 224.201 141.570 C 223.682 140.432, 222.519 134.006, 221.617 127.291 C 219.719 113.165, 213.465 87.415, 208.356 72.695 C 199.166 46.216, 187.888 33.071, 170.465 28.533 C 161.863 26.292, 157.859 26.596, 142.413 30.662 C 129.121 34.161, 127.763 34.325, 112 34.345 C 96.501 34.365, 94.772 34.170, 83.500 31.129 C 69.024 27.224, 61.441 26.552, 53.760 28.496 M 157 61.709 C 149.546 64.450, 149.583 75.265, 157.055 77.869 C 164.461 80.451, 171.088 72.939, 167.509 66.018 C 165.420 61.978, 161.094 60.204, 157 61.709 M 37.840 74.887 C 21.794 85.062, 29.010 110, 48 110 C 59.143 110, 67 102.143, 67 91 C 67 79.736, 59.157 72, 47.736 72 C 43.562 72, 41.394 72.632, 37.840 74.887 M 132.923 84.923 C 128.823 89.023, 128.883 93.882, 133.077 97.411 C 136.757 100.507, 140.807 100.727, 144.253 98.016 C 149.230 94.101, 148.515 86.352, 142.909 83.453 C 138.733 81.293, 136.177 81.670, 132.923 84.923 M 174.923 84.923 C 172.928 86.918, 172 88.848, 172 91 C 172 94.937, 176.712 100, 180.376 100 C 189.075 100, 193.099 90.945, 187.077 84.923 C 183.147 80.993, 178.853 80.993, 174.923 84.923 M 153.923 105.923 C 148.967 110.879, 150.248 117.952, 156.580 120.598 C 159.544 121.836, 160.456 121.836, 163.420 120.598 C 169.752 117.952, 171.033 110.879, 166.077 105.923 C 162.147 101.993, 157.853 101.993, 153.923 105.923 M 0.370 153 C 0.370 158.775, 0.535 161.137, 0.737 158.250 C 0.939 155.363, 0.939 150.637, 0.737 147.750 C 0.535 144.863, 0.370 147.225, 0.370 153" 
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="28" Height="24" Stretch="Uniform" Margin="-2,0,15,0"/>
                                <TextBlock Text="Show Playnite" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
                            </Style>
                        </Button.Resources>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource FocusRimBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </Trigger>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SelectedSurfaceBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource FocusRimBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="SuspendGameButton" Height="70" Width="260" 
                        FontSize="20" FontWeight="SemiBold"
                        Padding="20,10" Margin="0,0,0,20"
                        Command="{Binding SuspendGameCommand}" ClickMode="Press"
                        Visibility="{Binding ShowSuspendButton, Converter={StaticResource BoolToVis}}">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
                            </Style>
                        </Button.Resources>
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource FocusRimBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </Trigger>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SelectedSurfaceBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource FocusRimBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Path Data="M6,5 L10,5 L10,19 L6,19 Z M14,5 L18,5 L18,19 L14,19 Z" 
                                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Width="18" Height="18" Stretch="Uniform" Margin="2,0,17,0"/>
                            <TextBlock Text="Suspend" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CloseGameButton" Height="70" Width="260" 
                        FontSize="20" FontWeight="SemiBold"
                        Padding="20,10"
                        Command="{Binding CloseGameCommand}" ClickMode="Press">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
                            </Style>
                        </Button.Resources>
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource FocusRimBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </Trigger>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SelectedSurfaceBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource FocusRimBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" 
                                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                Width="20" Height="20" Stretch="Uniform" Margin="2,0,17,0"/>
                            <TextBlock Text="Exit Game" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

                        <!-- Achievement summary (in left column stack) -->
            <Button x:Name="AchievementPanel" 
                    Width="377" HorizontalAlignment="Left" Margin="0,0,0,16"
                    Visibility="{Binding HasAchievements, Converter={StaticResource BoolToVis}}"
                    Command="{Binding OpenAchievementBrowserCommand}" ClickMode="Press"
                    Focusable="True" Cursor="Hand" Padding="0" BorderThickness="0" Background="Transparent">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource AchievementPanelBrush}" CornerRadius="{DynamicResource PanelCornerRadius}" Padding="20,16,20,16"
                                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="{DynamicResource PanelBorderThickness}"
                                x:Name="AchBorder">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="4" Background="#80808080" Margin="0,6,15,0" VerticalAlignment="Top">
                                    <Border.Clip>
                                        <RectangleGeometry RadiusX="4" RadiusY="4" Rect="0,0,32,32"/>
                                    </Border.Clip>
                                    <Image Stretch="UniformToFill" Width="32" Height="32" Source="{Binding LastAchievement.IconUrl}"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="RECENT ACHIEVEMENT" FontSize="11" Foreground="#80808080"/>
                                        <TextBlock Text="&#8226;" FontSize="11" Foreground="#60808080" Margin="4,0,4,0"/>
                                        <TextBlock Text="{Binding LastAchievementTimeText}" FontSize="11" Foreground="#80808080"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding LastAchievement.Name}" Foreground="White" FontWeight="Bold" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding LastAchievement.Description}" Foreground="#FFD0D0D0" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36"/>
                                    <TextBlock Text="{Binding LastAchievement.RarityText}" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LastAchievement.RarityText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding UnlockPercentText}" FontSize="12" Foreground="White"
                                               FontWeight="SemiBold" Margin="0,12,0,0"/>
                                    <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding UnlockProgress}"
                                                 Margin="0,6,0,0" Foreground="{DynamicResource AccentBrush}" Background="#40404040" BorderThickness="0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="AchBorder" Property="BorderBrush" Value="{DynamicResource FocusRimBrush}"/>
                                <Setter TargetName="AchBorder" Property="BorderThickness" Value="{DynamicResource FocusRimThickness}"/>
                                <Setter TargetName="AchBorder" Property="Background" Value="{DynamicResource AchievementSelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="AchBorder" Property="Background" Value="{DynamicResource AchievementItemHoverBrush}"/>
                                <Setter TargetName="AchBorder" Property="BorderBrush" Value="{DynamicResource FocusRimBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Volume in left column -->
            <Border x:Name="AudioPanel" Background="{DynamicResource PanelBackgroundBrush}" Visibility="{Binding ShowAudioPanel, Converter={StaticResource BoolToVis}}" CornerRadius="{DynamicResource PanelCornerRadius}" Padding="22,14,24,14"
                    Width="320" MinWidth="280" HorizontalAlignment="Left"
                    Margin="0,0,0,0" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="{DynamicResource PanelBorderThickness}"
                    Panel.ZIndex="40"
                    PreviewMouseLeftButtonDown="AudioPanel_PreviewMouseLeftButtonDown"
                    MouseLeftButtonUp="AudioPanel_MouseLeftButtonUp"
                    MouseMove="AudioPanel_MouseMove">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="AudioPanelTransform" X="0" Y="0"/>
                </Border.RenderTransform>
                <StackPanel>
                    <TextBlock Text="VOLUME" FontSize="11" Foreground="#80808080" FontWeight="SemiBold" Margin="0,0,0,8" Cursor="SizeAll"/>
                    <Grid Margin="0,0,0,10" Height="34">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="MasterMuteButton" Grid.Column="0" Width="32" Height="32"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="0,0,0,0"
                                Padding="0" BorderThickness="0" Background="Transparent"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Style="{StaticResource OverlayFocusButton}"
                                ToolTip="{Binding GameMuteButtonToolTip}"
                                ClickMode="Press"
                                Click="MasterMuteButton_Click">
                            <!-- One 24x24 canvas: the speaker body and the waves / mute cross are laid out
                                 inside it, so the icon is optically centred in the button in both states. -->
                            <Canvas Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    SnapsToDevicePixels="False" UseLayoutRounding="False">
                                <Path Data="M3,9 H7 L12,5 V19 L7,15 H3 Z" Fill="White" Stroke="White"
                                      StrokeThickness="1" StrokeLineJoin="Round"/>
                                <Path Data="M15.2,9.4 C16.8,10.8 16.8,13.2 15.2,14.6 M17.6,6.8 C20.8,9.6 20.8,14.4 17.6,17.2"
                                      Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Fill="Transparent">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGameMuted}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <Path Data="M15.5,9.5 L20.5,14.5 M20.5,9.5 L15.5,14.5" Stroke="White"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Fill="Transparent">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGameMuted}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Canvas>
                        </Button>
                        <Grid Grid.Column="1" Height="28">
                            <TextBlock x:Name="VolumeValueText" FontSize="18" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Cursor="IBeam" ToolTip="Click to type a volume %"
                                       MouseLeftButtonDown="VolumeValueText_Click">
                                <Run Text="{Binding VolumePercent, Mode=OneWay}"/>
                                <Run Text=" %"/>
                            </TextBlock>
                            <TextBox x:Name="VolumeValueEdit" FontSize="18" FontWeight="Bold"
                                     Background="{DynamicResource SurfaceBrush}" Foreground="White" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                     HorizontalContentAlignment="Center" VerticalAlignment="Center" Padding="2,1" CaretBrush="White"
                                     Visibility="Collapsed"
                                     KeyDown="VolumeValueEdit_KeyDown"
                                     LostFocus="VolumeValueEdit_LostFocus"/>
                        </Grid>
                        <Border x:Name="VolumeSliderFocusBorder" Grid.Column="2"
                                BorderBrush="Transparent" BorderThickness="2" CornerRadius="6"
                                Margin="6,0,0,0" Padding="0" Height="32" VerticalAlignment="Center">
                            <Slider x:Name="GameVolumeSlider" Minimum="0" Maximum="1"
                                    Value="{Binding VolumeLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Height="28"
                                    LargeChange="0.05" SmallChange="0.01"
                                    Style="{StaticResource OverlayFocusSlider}"
                                    GotKeyboardFocus="GameVolumeSlider_GotFocus"
                                    LostKeyboardFocus="GameVolumeSlider_LostFocus"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="OUTPUT DEVICE" FontSize="11" Foreground="#80808080" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ListBox x:Name="AudioDeviceListBox"
                             ItemsSource="{Binding AudioDevices}"
                             SelectedItem="{Binding SelectedAudioDevice, Mode=TwoWay}"
                             DisplayMemberPath="Name"
                             Height="72" Margin="0,0,0,6"
                             Background="Transparent" Foreground="White"
                             BorderThickness="0" FocusVisualStyle="{x:Null}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             GotKeyboardFocus="AudioDeviceListBox_GotKeyboardFocus"
                             SelectionChanged="AudioDeviceListBox_SelectionChanged"
                             PreviewMouseLeftButtonDown="AudioDeviceListBox_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="AudioDeviceListBox_PreviewMouseLeftButtonUp">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="BorderBrush" Value="#40505050"/>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="MinHeight" Value="32"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="1">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- Keep the active/selected output easy to identify without
                                                     the hard gray slab that broke the frosted panel. -->
                                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#FF333333"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}"/>
                                                </Trigger>
                                                <!-- Keep active device highlighted even while hovering another row is handled by IsDefault;
                                                     when hovering the active row, prefer the accent fill over grey -->
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                        <Condition Property="IsSelected" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <!-- Status/error text (shown in red for a split second) is intentionally hidden; AudioStatusText stays bound for future use. -->
                    <TextBlock Text="{Binding AudioStatusText}" FontSize="11" Foreground="#FFFF8A80"
                               TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
            </StackPanel><!-- end LeftColumn -->

            <!-- Content container -->
            <TextBlock x:Name="GameTitle" Text="{Binding GameTitle}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Left" 
                           Margin="38,4,0,0" Height="56" VerticalAlignment="Top" FontSize="36" Width="1309"/>
            <Border x:Name="OuterImgBorder" 
        BorderBrush="{DynamicResource PanelBorderBrush}" 
        BorderThickness="{DynamicResource PanelBorderThickness}" 
        Width="{Binding CoverWidth}" 
        Height="{Binding CoverHeight}" 
        Margin="0,120,36,0" 
        HorizontalAlignment="Right" 
        VerticalAlignment="Top" 
        CornerRadius="8,8,8,8" 
        Background="{DynamicResource CoverFrameBrush}">
                <Border x:Name="InnerImgBorder" 
            BorderBrush="Transparent" 
            BorderThickness="0,0,0,0" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top" 
            CornerRadius="7,7,7,7" 
            Margin="1,1,1,1">
                    <Border.Clip>
                        <RectangleGeometry RadiusX="7" RadiusY="7" x:Name="ImgBorderClip">
                            <RectangleGeometry.Rect>
                                <Binding Path="InnerRect" />
                            </RectangleGeometry.Rect>
                        </RectangleGeometry>
                    </Border.Clip>
                    <Image x:Name="GameCoverImage" 
               Source="{Binding CoverImagePath}"
               Stretch="UniformToFill" 
               VerticalAlignment="Center" 
               HorizontalAlignment="Center"/>
                </Border>
            </Border>
            <!-- Clock -->
            <TextBlock x:Name="Clock" Text="{Binding CurrentTime}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right" 
                       Margin="0,5,36,0" VerticalAlignment="Top" FontSize="24" Width="74" TextAlignment="Right" />

            <Grid x:Name="Battery" Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}">
                <Rectangle x:Name="BatteryBar" HorizontalAlignment="Left" Height="17" Margin="1437,13,0,0" Fill="#FF48AF30" VerticalAlignment="Top" Width="{Binding BatteryBarWidth}"/>
                <Rectangle HorizontalAlignment="Right" Height="17" Margin="0,13,121,0" Fill="White" VerticalAlignment="Top" Width="5"/>
                <Rectangle Stroke="White" Margin="0,9,124,0" StrokeThickness="4" Width="43" HorizontalAlignment="Right" VerticalAlignment="Top" Height="25"/>
                <TextBlock x:Name="BatteryText" Text="{Binding BatteryPercentage, StringFormat={}{0}%}" HorizontalAlignment="Left" Margin="1436,13,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontWeight="Bold" Foreground="White" Width="37" TextAlignment="Center" Height="16"/>
            </Grid>
            <TextBlock x:Name="ProcessInfo_DEBUG" Text="{Binding DebugInfo}" Visibility="{Binding DebugVisible, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Left" Margin="355,124,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="286" Width="821" Foreground="White" RenderTransformOrigin="0.526,0.47"/>

            <!-- FPS Limiter panel (RTSS) — draggable -->
            <Border x:Name="FpsPanel" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="{DynamicResource PanelCornerRadius}" Padding="16,14"
                    Width="320" MinWidth="280" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="370,120,0,0" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="{DynamicResource PanelBorderThickness}"
                    Visibility="{Binding ShowFpsPanel, Converter={StaticResource BoolToVis}}"
                    Panel.ZIndex="50"
                    MouseLeftButtonDown="FpsPanel_MouseLeftButtonDown"
                    MouseLeftButtonUp="FpsPanel_MouseLeftButtonUp"
                    MouseMove="FpsPanel_MouseMove">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="FpsPanelTransform" X="0" Y="0"/>
                </Border.RenderTransform>
                <StackPanel>
                    <Grid Margin="0,0,0,8" Cursor="SizeAll">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="FPS LIMITER" FontSize="11" Foreground="#80808080" FontWeight="SemiBold"/>
                    </Grid>
                    <Grid Margin="0,0,0,8" Height="28">
                        <TextBlock x:Name="FpsValueText"
                                   Text="{Binding FpsLimitLabel}"
                                   FontSize="18" FontWeight="Bold" Foreground="White"
                                   VerticalAlignment="Center" Cursor="IBeam" ToolTip="Click to type a limit"
                                   MouseLeftButtonDown="FpsValueText_Click"/>
                        <TextBox x:Name="FpsValueEdit" FontSize="18" FontWeight="Bold"
                                 Background="{DynamicResource SurfaceBrush}" Foreground="White" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                 VerticalAlignment="Center" Padding="4,2" CaretBrush="White"
                                 Visibility="Collapsed"
                                 KeyDown="FpsValueEdit_KeyDown"
                                 LostFocus="FpsValueEdit_LostFocus"/>
                    </Grid>

                    <!-- Presets: FPS list, or display refresh rates when RTSS Scanline Sync is active -->
                    <TextBlock Text="{Binding PresetSectionTitle}" FontSize="11" Foreground="#80808080" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding FpsPresets}" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Value, StringFormat={}{0:0.###}}" MinWidth="56" Height="30" Margin="0,0,6,6" Cursor="Hand"
                                        Command="{Binding DataContext.SetFpsLimitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Value}"
                                        Style="{StaticResource FpsPresetButton}" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Height="32" Margin="0,0,0,8" Cursor="Hand" HorizontalAlignment="Stretch"
                            Command="{Binding DisableFpsCapCommand}"
                            Style="{StaticResource OverlayFocusButtonDanger}"
                            Padding="8,4" FontSize="13">
                        <TextBlock Text="Disable FPS cap" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- RTSS sync modes only (hidden when Special K is selected) -->
                    <StackPanel Visibility="{Binding ShowRtssSyncModes, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="SYNC MODE" FontSize="11" Foreground="#80808080" FontWeight="SemiBold" Margin="0,4,0,6"/>
                        <TextBlock Text="{Binding SyncModeLabel}" FontSize="13" Foreground="White" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"/>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="Async" Width="90" Padding="4,6" Margin="0,0,4,6" Cursor="Hand"
                                    Command="{Binding SetSyncModeCommand}" CommandParameter="Async"
                                    Style="{StaticResource OverlayFocusButton}"/>
                            <Button Content="Front Edge" Width="90" Padding="4,6" Margin="0,0,4,6" Cursor="Hand"
                                    Command="{Binding SetSyncModeCommand}" CommandParameter="FrontEdgeSync"
                                    Style="{StaticResource OverlayFocusButton}"/>
                            <Button Content="Back Edge" Width="90" Padding="4,6" Margin="0,0,4,6" Cursor="Hand"
                                    Command="{Binding SetSyncModeCommand}" CommandParameter="BackEdgeSync"
                                    Style="{StaticResource OverlayFocusButton}"/>
                            <Button Content="Reflex" Width="90" Padding="4,6" Margin="0,0,4,6" Cursor="Hand"
                                    Command="{Binding SetSyncModeCommand}" CommandParameter="ReflexSync"
                                    Style="{StaticResource OverlayFocusButton}"/>
                            <Button Visibility="{Binding FixedRefreshDisplayMode, Converter={StaticResource BoolToVis}}" Content="Scanline" Width="90" Padding="4,6" Margin="0,0,4,6" Cursor="Hand"
                                    Command="{Binding SetSyncModeCommand}" CommandParameter="ScanlineSync"
                                    Style="{StaticResource OverlayFocusButton}"/>
                            <Button Visibility="{Binding FixedRefreshDisplayMode, Converter={StaticResource BoolToVis}}" Content="Scanline x/2" Width="90" Padding="4,6" Margin="0,0,4,6" Cursor="Hand"
                                    Command="{Binding SetSyncModeCommand}" CommandParameter="ScanlineSyncHalf"
                                    Style="{StaticResource OverlayFocusButton}"/>
                        </WrapPanel>

                        <!-- Scanline Sync target tuning. Visible only in RTSS Scanline mode. -->
                        <StackPanel Margin="0,0,0,10"
                                    Visibility="{Binding ShowScanlineTarget, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="SCANLINE TARGET" FontSize="11" Foreground="#80808080"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ScanlineSyncTargetLabel}" FontSize="13" Foreground="White"
                                           FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Slider x:Name="ScanlineTargetSlider" Minimum="-500" Maximum="500" TickFrequency="1" IsSnapToTickEnabled="True"
                                    SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True"
                                    Style="{StaticResource OverlayFocusSlider}"
                                    Value="{Binding ScanlineSyncTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Thumb.DragCompleted="ScanlineTargetSlider_DragCompleted"
                                    PreviewMouseLeftButtonUp="ScanlineTargetSlider_MouseUp"
                                    ToolTip="RTSS SyncScanline0 (-500 to 500)"/>
                            <Grid Margin="0,5,0,0">
                                <TextBox Width="72" HorizontalAlignment="Left" Padding="5,2"
                                         Background="{DynamicResource SurfaceBrush}" Foreground="White" BorderBrush="#FF555A66"
                                         x:Name="ScanlineTargetBox"
                                         Text="{Binding ScanlineSyncTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                         KeyDown="ScanlineTargetBox_KeyDown"
                                         LostFocus="ScanlineTargetBox_LostFocus"
                                         ToolTip="Type an exact SyncScanline0 value (applies right away, Enter applies instantly)"/>
                                <Button Content="Default (-1)" Padding="8,3" HorizontalAlignment="Right"
                                        Command="{Binding SetScanlineTargetCommand}" CommandParameter="-1"
                                        Style="{StaticResource OverlayFocusButton}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <Button Padding="10,8" Cursor="Hand" HorizontalAlignment="Stretch"
                            Visibility="{Binding ShowRtssSyncModes, Converter={StaticResource BoolToVis}}"
                            Command="{Binding ToggleReflexMarkersCommand}"
                            Style="{StaticResource OverlayFocusButton}" Margin="0,0,0,0"
                            FontSize="13">
                        <TextBlock Text="{Binding ReflexMarkersLabel}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Playtime footer sits directly under the cover and follows its selected aspect ratio. -->
            <Border x:Name="SessionPanel" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="{DynamicResource PanelCornerRadius}" 
                    Width="{Binding CoverWidth}" Height="56" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,120,36,0"
                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="{DynamicResource PanelBorderThickness}" Padding="18,8,18,4">
                <Border.RenderTransform>
                    <TranslateTransform Y="{Binding CoverHeight}"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Vertical Divider -->
                    <Rectangle Grid.Column="1" Grid.Row="0" Width="1" Margin="24,2,24,-11" Fill="#80808080" VerticalAlignment="Stretch"/>

                    <!-- Total Play Time (Column 0) -->
                    <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Path Fill="#FFD0D0D0" 
                              Width="16" 
                              Height="16"
                              Data="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71z" Margin="0,0,8,0"/>
                        <TextBlock x:Name="PlayTime" Text="{Binding TotalPlaytimeText}" TextWrapping="Wrap" Foreground="#FFFFFFFF" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Session Play Time (Column 2) -->
                    <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Path Fill="#FFD0D0D0" 
                              Width="16" 
                              Height="16"
                              Data="M6.5 0a.5.5 0 0 0 0 1H7v1.07A7.001 7.001 0 0 0 8 16a7 7 0 0 0 5.29-11.584l.013-.012.354-.354.353.354a.5.5 0 1 0 .707-.707l-1.414-1.415a.5.5 0 1 0-.707.707l.354.354-.354.354-.012.012A6.97 6.97 0 0 0 9 2.071V1h.5a.5.5 0 0 0 0-1zm2 5.6V9a.5.5 0 0 1-.5.5H4.5a.5.5 0 0 1 0-1h3V5.6a.5.5 0 1 1 1 0" Margin="0,0,8,0"/>
                        <TextBlock x:Name="SessionTime" Text="{Binding SessionPlaytimeText}" TextWrapping="Wrap" Foreground="#FFFFFFFF" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Caption Labels - Left Aligned -->
                    <TextBlock Grid.Column="0" Grid.Row="1" Text="ALL TIME" FontSize="9" Foreground="#80808080" HorizontalAlignment="Left" Margin="24,2,0,0"/>
                    <TextBlock Grid.Column="2" Grid.Row="1" Text="THIS SESSION" FontSize="9" Foreground="#80808080" HorizontalAlignment="Left" Margin="24,2,0,0"/>
                </Grid>
            </Border>

                        <!-- Full achievement browser (Steam-style dark) -->
            <Grid Visibility="{Binding IsAchievementBrowserOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="100">
                <Rectangle Fill="#E0000000"/>
                <Border Background="{DynamicResource AchievementWindowBrush}" CornerRadius="10" BorderBrush="{DynamicResource AchievementWindowBorderBrush}" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="1280"/>
                            <Setter Property="Height" Value="760"/>
                            <Setter Property="MaxWidth" Value="1500"/>
                            <Setter Property="MaxHeight" Value="850"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AchievementStyle}" Value="Desktop">
                                    <Setter Property="Width" Value="720"/>
                                    <Setter Property="Height" Value="720"/>
                                    <Setter Property="MaxWidth" Value="900"/>
                                    <Setter Property="MaxHeight" Value="820"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="8" Direction="270" Opacity="0.55" Color="Black"/>
                    </Border.Effect>
                    <DockPanel>
                        <!-- Console achievement header -->
                        <Border DockPanel.Dock="Top" Padding="24,18" BorderBrush="{DynamicResource AchievementDividerBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource AchievementHeaderBrush}" CornerRadius="10,10,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AchievementStyle}" Value="Desktop">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="60" CornerRadius="4" Background="#FF101216" BorderBrush="#338C969F" BorderThickness="1" VerticalAlignment="Center">
                                    <Image Source="{Binding CoverImagePath}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,24,0">
                                    <TextBlock Text="{Binding GameTitle}" FontSize="23" FontWeight="Light" Foreground="#FFF1F2F3" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="All achievements: " FontSize="13" Foreground="#FF9AA2AA"/>
                                        <TextBlock Text="{Binding TotalAchievementCount}" FontSize="13" Foreground="#FFCFD4D9" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="PROGRESS" FontSize="11" Foreground="#FF8F98A0"/>
                                        <TextBlock Text="{Binding UnlockProgress, StringFormat={}{0:P0}}" FontSize="22" Foreground="#FFF0F1F2" Margin="0,3,0,0"/>
                                        <ProgressBar Height="2" Minimum="0" Maximum="1" Value="{Binding UnlockProgress}" Margin="0,5,0,0" Width="96" HorizontalAlignment="Left" Foreground="#FFEDEFF1" Background="#33FFFFFF" BorderThickness="0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="EARNED" FontSize="11" Foreground="#FF8F98A0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding UnlockedCount}" FontSize="22" Foreground="#FFF0F1F2"/>
                                            <TextBlock Text=" / " FontSize="19" Foreground="#FF727A82" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TotalAchievementCount}" FontSize="22" Foreground="#FFB6BCC2"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="26,0,0,0" ToolTip="Gold: unlocked achievements earned by under 10% of players">
                                        <Viewbox Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M7,3 L17,3 L17,8.5 C17,11.5 14.8,13.4 12,13.4 C9.2,13.4 7,11.5 7,8.5 Z" Fill="#FFE2B04A"/>
                                                <Path Data="M7,5 L4,5 L4,7 C4,9 5.6,10.6 7.6,10.9 M17,5 L20,5 L20,7 C20,9 18.4,10.6 16.4,10.9" Stroke="#FFE2B04A" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                <Path Data="M10.8,13.4 L13.2,13.4 L13.2,17 L10.8,17 Z M8,21 L9,17 L15,17 L16,21 Z" Fill="#FFE2B04A"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="{Binding GoldTrophyCount}" FontSize="22" Foreground="#FFF0F1F2" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="26,0,0,0" ToolTip="Silver: unlocked achievements earned by 10% to under 50% of players">
                                        <Viewbox Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M7,3 L17,3 L17,8.5 C17,11.5 14.8,13.4 12,13.4 C9.2,13.4 7,11.5 7,8.5 Z" Fill="#FFB9C2CC"/>
                                                <Path Data="M7,5 L4,5 L4,7 C4,9 5.6,10.6 7.6,10.9 M17,5 L20,5 L20,7 C20,9 18.4,10.6 16.4,10.9" Stroke="#FFB9C2CC" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                <Path Data="M10.8,13.4 L13.2,13.4 L13.2,17 L10.8,17 Z M8,21 L9,17 L15,17 L16,21 Z" Fill="#FFB9C2CC"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="{Binding SilverTrophyCount}" FontSize="22" Foreground="#FFF0F1F2" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="26,0,0,0" ToolTip="Bronze: unlocked achievements earned by 50% or more of players">
                                        <Viewbox Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M7,3 L17,3 L17,8.5 C17,11.5 14.8,13.4 12,13.4 C9.2,13.4 7,11.5 7,8.5 Z" Fill="#FFC9784F"/>
                                                <Path Data="M7,5 L4,5 L4,7 C4,9 5.6,10.6 7.6,10.9 M17,5 L20,5 L20,7 C20,9 18.4,10.6 16.4,10.9" Stroke="#FFC9784F" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                <Path Data="M10.8,13.4 L13.2,13.4 L13.2,17 L10.8,17 Z M8,21 L9,17 L15,17 L16,21 Z" Fill="#FFC9784F"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="{Binding BronzeTrophyCount}" FontSize="22" Foreground="#FFF0F1F2" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="3" Content="✕" Width="36" Height="36" FontSize="14" FontWeight="Bold"
                                        Style="{StaticResource OverlayCloseButton}"
                                        Command="{Binding CloseAchievementBrowserCommand}" ClickMode="Press"
                                        VerticalAlignment="Top" HorizontalAlignment="Right"
                                        IsTabStop="True" ToolTip="Close"/>
                            </Grid>
                        </Border>

                        <!-- Desktop compact header (previous achievement style) -->
                        <Border DockPanel.Dock="Top" Padding="20,14" BorderBrush="{DynamicResource AchievementDividerBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource AchievementHeaderBrush}" CornerRadius="8,8,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AchievementStyle}" Value="Desktop">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Achievements" FontSize="20" FontWeight="Bold" Foreground="#FFE8E8E8"/>
                                    <TextBlock Text="{Binding UnlockPercentText}" FontSize="12" Foreground="#FF8B929A" Margin="0,3,0,0"/>
                                    <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding UnlockProgress}"
                                                 Margin="0,8,40,0" Width="280" HorizontalAlignment="Left"
                                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceHoverBrush}" BorderThickness="0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="✕" Width="36" Height="36" FontSize="14" FontWeight="Bold"
                                        Style="{StaticResource OverlayCloseButton}"
                                        Command="{Binding CloseAchievementBrowserCommand}" ClickMode="Press"
                                        VerticalAlignment="Top" HorizontalAlignment="Right"
                                        IsTabStop="True" ToolTip="Close"/>
                            </Grid>
                        </Border>

                        <!-- Filter tabs -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,10,16,6">
                            <Button Content="All" Padding="12,5" Margin="0,0,6,0" Cursor="Hand"
                                    Command="{Binding SetAchievementFilterCommand}" CommandParameter="All"
                                    Background="{DynamicResource SurfaceHoverBrush}" Foreground="#FFE8E8E8" BorderThickness="0" FontWeight="SemiBold"/>
                            <Button Content="Unlocked" Padding="12,5" Margin="0,0,6,0" Cursor="Hand"
                                    Command="{Binding SetAchievementFilterCommand}" CommandParameter="Unlocked"
                                    Background="{DynamicResource SurfaceBrush}" Foreground="#FFC7D5E0" BorderThickness="0"/>
                            <Button Content="Locked" Padding="12,5" Cursor="Hand"
                                    Command="{Binding SetAchievementFilterCommand}" CommandParameter="Locked"
                                    Background="{DynamicResource SurfaceBrush}" Foreground="#FFC7D5E0" BorderThickness="0"/>
                        </StackPanel>

                        <!-- Scrollable list -->
                        <ListBox x:Name="AchievementListBox"
                                 ItemsSource="{Binding FilteredAchievements}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Margin="6,0,6,10"
                                 Focusable="True"
                                 IsTabStop="True"
                                 KeyboardNavigation.DirectionalNavigation="Contained"
                                 KeyboardNavigation.TabNavigation="Once"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.CanContentScroll="True">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="14,14"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Focusable" Value="True"/>
                                    <Setter Property="IsTabStop" Value="True"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="{DynamicResource AchievementItemBrush}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="{DynamicResource AchievementItemBorderBrush}" ClipToBounds="True">
                                                    <Grid>
                                                        <Border x:Name="SelBar" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="-8,3,0,3"
                                                                Background="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                                                        <ContentPresenter/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AchievementItemHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AchievementSelectedBorderBrush}"/>
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AchievementSelectedBrush}"/>
                                                        <Setter TargetName="SelBar" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AchievementSelectedBorderBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.AchievementStyle, RelativeSource={RelativeSource AncestorType=Window}}" Value="Desktop">
                                            <Setter Property="Padding" Value="12,8"/>
                                            <Setter Property="Margin" Value="0,0,0,2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                    <Grid x:Name="DesktopAchievementCard" Visibility="Collapsed" Opacity="{Binding DisplayOpacity}" MinHeight="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="3" Background="#FF12141A" Margin="0,0,10,0">
                                            <Border.Clip>
                                                <RectangleGeometry RadiusX="3" RadiusY="3" Rect="0,0,42,42"/>
                                            </Border.Clip>
                                            <Image Source="{Binding IconUrl}" Stretch="UniformToFill" Width="42" Height="42"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="#FFE8E8E8" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}" Foreground="#FF8B929A" FontSize="11" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                            <TextBlock Text="{Binding RarityText}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#FF8F98A0"/>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RarityText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding RarityColor}" Value="#FFE4AE39"><Setter Property="Foreground" Value="#FFD4A84B"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding RarityColor}" Value="#FFB072FF"><Setter Property="Foreground" Value="#FFB072FF"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding RarityColor}" Value="#FF66C0F4"><Setter Property="Foreground" Value="#FF66C0F4"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding RarityColor}" Value="#FF5BAE5B"><Setter Property="Foreground" Value="#FF5BAE5B"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding RarityColor}" Value="#FFA0B0C0"><Setter Property="Foreground" Value="#FFA0B0C0"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding StatusText}" Foreground="#FF8B929A" FontSize="10" TextAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid x:Name="ConsoleAchievementCard" Opacity="{Binding DisplayOpacity}" MinHeight="116">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="1.25*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="88" Height="88" CornerRadius="5" Background="#FF101216" BorderBrush="#338C969F" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Left" ClipToBounds="True">
                                            <Image Source="{Binding IconUrl}" Stretch="UniformToFill"/>
                                        </Border>
                                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="4,0,22,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" Foreground="#FFF4F5F6" FontWeight="SemiBold" FontSize="19" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                                                <Path Data="M2,3 L14,3 L14,13 L2,13 Z M2,6 L14,6 M5,1 L5,4 M11,1 L11,4" Stroke="#FF9FA7AF" StrokeThickness="1.1" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="#FFB4BAC0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                                                <TextBlock Text="●" FontSize="10" VerticalAlignment="Center" Margin="0,0,9,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#FF8F98A0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                                                    <Setter Property="Foreground" Value="#FFE0B44F"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding UnlockStateText}" FontSize="14" Foreground="#FFCFD4D9"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,7,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RarityDetailText}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Path Data="M7,1 L13,12 L1,12 Z" Fill="{Binding RarityColor}" Width="14" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.9"/>
                                                <TextBlock Text="{Binding RarityDetailText}" FontSize="14" Foreground="#FFA9B0B7" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                        <Border Grid.Column="2" Width="1" Background="#553A414A" Margin="0,6"/>
                                        <Border Grid.Column="3" Margin="0,-14,-14,-14" CornerRadius="0,8,8,0" ClipToBounds="True">
                                            <Grid>
                                                <Border Style="{StaticResource AchievementTintPane}"/>
                                                <Rectangle Fill="{StaticResource AchievementStripeBrush}" Opacity="0.55">
                                                    <Rectangle.OpacityMask>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#00000000" Offset="0.4"/>
                                                            <GradientStop Color="#FF000000" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Rectangle.OpacityMask>
                                                </Rectangle>
                                                <TextBlock Text="{Binding Description}" Foreground="#FFDDE0E4" FontSize="16" TextWrapping="Wrap" MaxHeight="76" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" Margin="24,22,18,14"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.AchievementStyle, RelativeSource={RelativeSource AncestorType=Window}}" Value="Desktop">
                                            <Setter TargetName="DesktopAchievementCard" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="ConsoleAchievementCard" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DataContext.AchievementStyle, RelativeSource={RelativeSource AncestorType=Window}}" Value="Console">
                                            <Setter TargetName="DesktopAchievementCard" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="ConsoleAchievementCard" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Shortcut Buttons -->
            <Border Focusable="False" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="{DynamicResource PanelCornerRadius}" x:Name="ShortcutBar"
                    MinWidth="64" MinHeight="64" VerticalAlignment="Bottom" HorizontalAlignment="Left" 
                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="{DynamicResource PanelBorderThickness}" Padding="4,4,4,4" Margin="40,0,0,20" Visibility="{Binding ShowShortcutButtons, Converter={StaticResource BoolToVis}}">
                <ItemsControl Focusable="False" ItemsSource="{Binding ShortcutButtons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="60" Height="60" Margin="4" ClickMode="Press"
                                    Command="{Binding DataContext.ShortcutButtonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    >
                                <Button.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                </Button.Resources>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Opacity" Value="0.7" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding Title}" TextAlignment="Center" 
               TextWrapping="Wrap" FontSize="10" Foreground="White" Margin="-75,-40,-75,0" 
               FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsFocused, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Image Grid.Row="1" Source="{Binding IconPath}" Width="32" Height="32" Margin="0,4,0,4"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Gamepad button prompts (General > Show gamepad button prompts) -->
            <Border x:Name="GamepadHintBar" Focusable="False" IsHitTestVisible="False"
                    VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,22" Padding="16,8"
                    Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="{DynamicResource PanelCornerRadius}"
                    BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="{DynamicResource PanelBorderThickness}"
                    Visibility="{Binding GamepadHintsVisible, Converter={StaticResource BoolToVis}}">
                <Border.Resources>
                    <Style x:Key="PadChip" TargetType="Border">
                        <Setter Property="Background" Value="#FF3A4150"/>
                        <Setter Property="CornerRadius" Value="11"/>
                        <Setter Property="MinWidth" Value="26"/>
                        <Setter Property="Height" Value="22"/>
                        <Setter Property="Padding" Value="7,0"/>
                        <Setter Property="Margin" Value="0,0,4,0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UseSonyPrompts}" Value="True">
                                <Setter Property="Background" Value="#FF000000"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="PadChipText" TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Symbol"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UseSonyPrompts}" Value="True">
                                <Setter Property="Foreground" Value="#FFE4E7F2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <!-- Xbox A / B chips are hidden when the PlayStation icons are in use -->
                    <Style x:Key="PadChipXboxOnly" TargetType="Border" BasedOn="{StaticResource PadChip}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UseSonyPrompts}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <!-- PlayStation face-button icon: black disc with a coloured symbol -->
                    <Style x:Key="PadSonyIcon" TargetType="Viewbox">
                        <Setter Property="Width" Value="22"/>
                        <Setter Property="Height" Value="22"/>
                        <Setter Property="Margin" Value="0,0,4,0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UseSonyPrompts}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="PadHintLabel" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Foreground" Value="#FFE8E8E8"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="4,0,22,0"/>
                    </Style>
                </Border.Resources>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource PadChipXboxOnly}"><TextBlock Style="{StaticResource PadChipText}" Text="D-Pad"/></Border>
                    <Viewbox Style="{StaticResource PadSonyIcon}">
                        <Canvas Width="22" Height="22">
                            <Ellipse Width="22" Height="22" Fill="#FF000000"/>
                            <Path Stroke="#FFE4E7F2" StrokeThickness="1.4" StrokeLineJoin="Round"
                                  Data="M8.6,4.6 L13.4,4.6 L13.4,8.6 L17.4,8.6 L17.4,13.4 L13.4,13.4 L13.4,17.4 L8.6,17.4 L8.6,13.4 L4.6,13.4 L4.6,8.6 L8.6,8.6 Z"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Style="{StaticResource PadHintLabel}" Text="Move"/>
                    <Border Style="{StaticResource PadChip}"><TextBlock Style="{StaticResource PadChipText}" Text="{Binding PromptLb}"/></Border>
                    <Border Style="{StaticResource PadChip}"><TextBlock Style="{StaticResource PadChipText}" Text="{Binding PromptRb}"/></Border>
                    <TextBlock Style="{StaticResource PadHintLabel}" Text="Previous / next item"/>
                    <Border Style="{StaticResource PadChip}"><TextBlock Style="{StaticResource PadChipText}" Text="{Binding PromptLt}"/></Border>
                    <Border Style="{StaticResource PadChip}"><TextBlock Style="{StaticResource PadChipText}" Text="{Binding PromptRt}"/></Border>
                    <TextBlock Style="{StaticResource PadHintLabel}" Text="Previous / next panel"/>
                    <Border Style="{StaticResource PadChipXboxOnly}" Background="#FF2E9E48"><TextBlock Style="{StaticResource PadChipText}" Text="A"/></Border>
                    <Viewbox Style="{StaticResource PadSonyIcon}">
                        <Canvas Width="22" Height="22">
                            <Ellipse Width="22" Height="22" Fill="#FF000000"/>
                            <Line X1="6.6" Y1="6.6" X2="15.4" Y2="15.4" Stroke="#FF9AACE3" StrokeThickness="1.9"/>
                            <Line X1="15.4" Y1="6.6" X2="6.6" Y2="15.4" Stroke="#FF9AACE3" StrokeThickness="1.9"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Style="{StaticResource PadHintLabel}" Text="Select"/>
                    <Border Style="{StaticResource PadChipXboxOnly}" Background="#FFC0392B"><TextBlock Style="{StaticResource PadChipText}" Text="B"/></Border>
                    <Viewbox Style="{StaticResource PadSonyIcon}">
                        <Canvas Width="22" Height="22">
                            <Ellipse Width="22" Height="22" Fill="#FF000000"/>
                            <Ellipse Canvas.Left="5.3" Canvas.Top="5.3" Width="11.4" Height="11.4" Stroke="#FFF06E6C" StrokeThickness="1.9"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Style="{StaticResource PadHintLabel}" Margin="4,0,0,0" Text="Back / close"/>
                </StackPanel>
            </Border>
        </Grid>
    </Viewbox>
    </Grid>
</Window>